<%- include('../partials/head', { title: server.name + ' Files', navbar: true, fluid: true }) %>

<%- include('../partials/serverNav', { server, active: 'files' }) %>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a href="/servers/<%= server.id %>/files" class="d-flex align-items-center gap-1">
                <span class="material-icons-outlined" style="font-size: 1rem;">home</span>
                root
            </a>
        </li>
        <%
        let crumbPath = '';
        breadcrumbs.forEach(function(crumb, i) {
            crumbPath += (crumbPath ? '/' : '') + crumb;
        %>
            <% if (i === breadcrumbs.length - 1) { %>
                <li class="breadcrumb-item active"><%= crumb %></li>
            <% } else { %>
                <li class="breadcrumb-item">
                    <a href="/servers/<%= server.id %>/files/<%= crumbPath %>"><%= crumb %></a>
                </li>
            <% } %>
        <% }) %>
    </ol>
</nav>

<%
// Downloads need the server stopped (it holds handles on world data and jars).
// Rendered once and gated declaratively so the page tracks live state — see
// applyStateGates in app.js.
const _serverStopped = ['stopped', 'crashed'].includes(server.state);
const _gate = 'stopped crashed';
const _isPluginsOrMods = currentPath === 'plugins' || currentPath === 'mods';
const _contentTypes = { paper: 'Plugins', purpur: 'Plugins', folia: 'Plugins', fabric: 'Mods', forge: 'Mods' };
const _hasContentTab = !!_contentTypes[server.serverType];
%>
<% if (_isPluginsOrMods) { %>
<div class="alert alert-warning d-flex align-items-center gap-2 mb-3<%= _serverStopped ? ' d-none' : '' %>" data-hide-when="<%= _gate %>">
    <span class="material-icons-outlined">warning</span>
    <div>
        Stop the server before modifying files in this folder. Changes while running may not take effect or could cause instability.
        <% if (_hasContentTab) { %>
        Use the <a href="/servers/<%= server.id %>/plugins" class="alert-link"><%=_contentTypes[server.serverType]%></a> tab for easier management.<% } %>
    </div>
</div>
<% } %>
<!-- Actions -->
<div class="d-flex gap-2 mb-3">
    <a href="/servers/<%= server.id %>/download-zip"
       class="btn btn-outline-success btn-sm d-flex align-items-center gap-1<%= _serverStopped ? '' : ' disabled' %>"
       data-enable-when="<%= _gate %>" data-disabled-title="Stop the server to download files" data-enabled-title=""
       <%= _serverStopped ? '' : 'aria-disabled="true" tabindex="-1" title="Stop the server to download files"' %>>
        <span class="material-icons-outlined" style="font-size: 1rem;">download</span>
        Download Server (.zip)
    </a>
</div>

<!-- File listing -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th>Name</th>
                    <th style="width: 120px;">Size</th>
                    <th style="width: 180px;">Modified</th>
                    <th style="width: 90px;"></th>
                </tr>
            </thead>
            <tbody>
                <% if (breadcrumbs.length > 0) { %>
                <tr>
                    <td>
                        <span class="material-icons-outlined text-body-secondary" style="font-size: 1.2rem;">arrow_upward</span>
                    </td>
                    <td colspan="4">
                        <a href="/servers/<%= server.id %>/files<%= parentPath ? '/' + parentPath : '' %>" class="text-decoration-none">..</a>
                    </td>
                </tr>
                <% } %>
                <% files.forEach(function(file) { %>
                <tr>
                    <td>
                        <span class="material-icons-outlined text-body-secondary" style="font-size: 1.2rem;">
                            <%= file.isDirectory ? 'folder' : 'description' %>
                        </span>
                    </td>
                    <td>
                        <% if (file.isDirectory) { %>
                            <a href="/servers/<%= server.id %>/files/<%= currentPath ? currentPath + '/' : '' %><%= file.name %>" class="text-decoration-none">
                                <%= file.name %>/
                            </a>
                        <% } else { %>
                            <%= file.name %>
                        <% } %>
                    </td>
                    <td class="text-body-secondary small"><%= file.isDirectory ? '—' : file.sizeFormatted %></td>
                    <td class="text-body-secondary small"><span class="format-date" data-iso="<%= file.modifiedISO %>"></span></td>
                    <td class="text-center">
                        <% if (!file.isDirectory) { %>
                        <div class="d-inline-flex gap-1">
                            <% if (file.editable) { %>
                            <a href="/servers/<%= server.id %>/edit-file?path=<%= encodeURIComponent((currentPath ? currentPath + '/' : '') + file.name) %>"
                               class="btn btn-outline-primary btn-sm d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" title="Edit">
                                <span class="material-icons-outlined" style="font-size: 1rem;">edit</span>
                            </a>
                            <% } %>
                            <a href="/servers/<%= server.id %>/download?path=<%= encodeURIComponent((currentPath ? currentPath + '/' : '') + file.name) %>"
                               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center<%= _serverStopped ? '' : ' disabled' %>"
                               style="width: 32px; height: 32px; padding: 0;"
                               data-enable-when="<%= _gate %>" data-enabled-title="Download" data-disabled-title="Stop server to download"
                               title="<%= _serverStopped ? 'Download' : 'Stop server to download' %>"
                               <%= _serverStopped ? '' : 'aria-disabled="true" tabindex="-1"' %>>
                                <span class="material-icons-outlined" style="font-size: 1rem;">download</span>
                            </a>
                        </div>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
                <% if (files.length === 0) { %>
                <tr>
                    <td colspan="5" class="text-center text-body-secondary py-4">This directory is empty.</td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/foot', { scripts: ['/js/serverState.js'] }) %>
