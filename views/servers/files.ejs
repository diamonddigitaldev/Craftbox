<%- include('../partials/head', { title: server.name + ' Files', navbar: true, fluid: true }) %>

<%- include('../partials/serverNav', { server, active: 'files' }) %>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a href="/servers/<%= server.id %>/files" class="d-flex align-items-center gap-1">
                <span class="material-icons-outlined" style="font-size: 1rem;">home</span>
                root
            </a>
        </li>
        <%
        let crumbPath = '';
        breadcrumbs.forEach(function(crumb, i) {
            crumbPath += (crumbPath ? '/' : '') + crumb;
        %>
            <% if (i === breadcrumbs.length - 1) { %>
                <li class="breadcrumb-item active"><%= crumb %></li>
            <% } else { %>
                <li class="breadcrumb-item">
                    <a href="/servers/<%= server.id %>/files/<%= crumbPath %>"><%= crumb %></a>
                </li>
            <% } %>
        <% }) %>
    </ol>
</nav>

<%
// Downloads, renames and deletes need the server stopped (it holds handles on
// world data and jars). Uploading and creating folders do not — see the file
// management block in api-v1/servers.js. Rendered once and gated declaratively
// so the page tracks live state — see applyStateGates in app.js.
const _serverStopped = ['stopped', 'crashed'].includes(server.state);
const _gate = 'stopped crashed';
const _isPluginsOrMods = currentPath === 'plugins' || currentPath === 'mods';
const _contentTypes = { paper: 'Plugins', purpur: 'Plugins', folia: 'Plugins', fabric: 'Mods', forge: 'Mods', neoforge: 'Mods' };
const _hasContentTab = !!_contentTypes[server.serverType];
%>

<!-- CSRF token and current directory for JS fetch calls -->
<input type="hidden" id="csrf-token" value="<%= csrfToken %>">
<input type="hidden" id="current-path" value="<%= currentPath %>">
<% if (_isPluginsOrMods) { %>
<div class="alert alert-warning d-flex align-items-center gap-2 mb-3<%= _serverStopped ? ' d-none' : '' %>" data-hide-when="<%= _gate %>">
    <span class="material-icons-outlined">warning</span>
    <div>
        Stop the server before modifying files in this folder. Changes while running may not take effect or could cause instability.
        <% if (_hasContentTab) { %>
        Use the <a href="/servers/<%= server.id %>/plugins" class="alert-link"><%=_contentTypes[server.serverType]%></a> tab for easier management.<% } %>
    </div>
</div>
<% } %>
<!-- Actions -->
<div class="d-flex gap-2 mb-3">
    <a href="/servers/<%= server.id %>/download-zip"
       class="btn btn-outline-success btn-sm d-flex align-items-center gap-1<%= _serverStopped ? '' : ' disabled' %>"
       data-enable-when="<%= _gate %>" data-disabled-title="Stop the server to download files" data-enabled-title=""
       <%= _serverStopped ? '' : 'aria-disabled="true" tabindex="-1" title="Stop the server to download files"' %>>
        <span class="material-icons-outlined" style="font-size: 1rem;">download</span>
        Download Server (.zip)
    </a>
</div>

<% if (files.length > 0) { %>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="input-group input-group-sm" style="max-width: 350px;">
        <span class="input-group-text"><span class="material-icons-outlined" style="font-size: 1rem;">search</span></span>
        <input type="text" class="form-control" id="search-input" placeholder="Search this folder...">
    </div>
</div>
<% } %>

<%# Uploading and creating folders are allowed while the server runs, so neither
    control is state-gated — only rename and delete below are. %>
<!-- Upload -->
<div class="d-flex gap-2 mb-3">
    <input type="file" class="form-control form-control-sm" id="file-input" multiple style="max-width: 400px;">
    <%# Upload stays disabled until files are picked, so files.js owns its enabled state. %>
    <button type="button" class="btn btn-success btn-sm d-flex align-items-center gap-1 flex-shrink-0" id="upload-btn" disabled>
        <span class="material-icons-outlined" style="font-size: 1rem;">upload</span>
        Upload
    </button>
    <button type="button" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1 flex-shrink-0" id="new-folder-btn">
        <span class="material-icons-outlined" style="font-size: 1rem;">create_new_folder</span>
        New Folder
    </button>
</div>

<!-- File listing -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th>Name</th>
                    <th style="width: 120px;">Size</th>
                    <th style="width: 180px;">Modified</th>
                    <th style="width: 160px;"></th>
                </tr>
            </thead>
            <tbody>
                <% if (breadcrumbs.length > 0) { %>
                <tr>
                    <td>
                        <span class="material-icons-outlined text-body-secondary" style="font-size: 1.2rem;">arrow_upward</span>
                    </td>
                    <td colspan="4">
                        <a href="/servers/<%= server.id %>/files<%= parentPath ? '/' + parentPath : '' %>" class="text-decoration-none">..</a>
                    </td>
                </tr>
                <% } %>
                <% files.forEach(function(file) { %>
                <% const _relPath = (currentPath ? currentPath + '/' : '') + file.name; %>
                <tr data-filename="<%= file.name %>" data-path="<%= _relPath %>" data-directory="<%= file.isDirectory %>">
                    <td>
                        <span class="material-icons-outlined text-body-secondary" style="font-size: 1.2rem;">
                            <%= file.isDirectory ? 'folder' : 'description' %>
                        </span>
                    </td>
                    <td>
                        <% if (file.isDirectory) { %>
                            <a href="/servers/<%= server.id %>/files/<%= _relPath %>" class="text-decoration-none">
                                <%= file.name %>/
                            </a>
                        <% } else { %>
                            <%= file.name %>
                        <% } %>
                    </td>
                    <td class="text-body-secondary small"><%= file.isDirectory ? '—' : file.sizeFormatted %></td>
                    <td class="text-body-secondary small"><span class="format-date" data-iso="<%= file.modifiedISO %>"></span></td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <% if (!file.isDirectory) { %>
                                <% if (file.editable) { %>
                                <a href="/servers/<%= server.id %>/edit-file?path=<%= encodeURIComponent(_relPath) %>"
                                   class="btn btn-outline-primary btn-sm d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" title="Edit">
                                    <span class="material-icons-outlined" style="font-size: 1rem;">edit</span>
                                </a>
                                <% } %>
                                <a href="/servers/<%= server.id %>/download?path=<%= encodeURIComponent(_relPath) %>"
                                   class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center<%= _serverStopped ? '' : ' disabled' %>"
                                   style="width: 32px; height: 32px; padding: 0;"
                                   data-enable-when="<%= _gate %>" data-enabled-title="Download" data-disabled-title="Stop server to download"
                                   title="<%= _serverStopped ? 'Download' : 'Stop server to download' %>"
                                   <%= _serverStopped ? '' : 'aria-disabled="true" tabindex="-1"' %>>
                                    <span class="material-icons-outlined" style="font-size: 1rem;">download</span>
                                </a>
                            <% } %>
                            <button type="button"
                                class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center rename-btn"
                                style="width: 32px; height: 32px; padding: 0;"
                                data-enable-when="<%= _gate %>"
                                data-enabled-title="Rename"
                                data-disabled-title="Stop the server to rename"
                                <%= _serverStopped ? '' : 'disabled' %>
                                title="<%= _serverStopped ? 'Rename' : 'Stop the server to rename' %>">
                                <span class="material-icons-outlined" style="font-size: 1rem;">drive_file_rename_outline</span>
                            </button>
                            <button type="button"
                                class="btn btn-outline-danger btn-sm d-inline-flex align-items-center justify-content-center delete-btn"
                                style="width: 32px; height: 32px; padding: 0;"
                                data-enable-when="<%= _gate %>"
                                data-enabled-title="Delete"
                                data-disabled-title="Stop the server to delete"
                                <%= _serverStopped ? '' : 'disabled' %>
                                title="<%= _serverStopped ? 'Delete' : 'Stop the server to delete' %>">
                                <span class="material-icons-outlined" style="font-size: 1rem;">delete</span>
                            </button>
                        </div>
                    </td>
                </tr>
                <% }) %>
                <% if (files.length === 0) { %>
                <tr>
                    <td colspan="5" class="text-center text-body-secondary py-4">This directory is empty.</td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Drop zone overlay (hidden until drag) -->
<div id="drop-overlay" class="d-none position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
    style="z-index: 1050; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); pointer-events: none;">
    <div class="text-center">
        <span class="material-icons-outlined text-success" style="font-size: 4rem;">upload_file</span>
        <h4 class="text-white mt-2">Drop files to upload here...</h4>
        <p class="text-white-50 mb-0">
            <%= currentPath ? currentPath : 'Server root' %>
        </p>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <span class="material-icons-outlined text-danger">delete</span>
                    <span id="delete-title">Delete File</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <%# Filled by files.js, which swaps in sterner copy for a folder. %>
            <div class="modal-body" id="delete-body"></div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="confirm-delete-btn">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Rename Modal -->
<div class="modal fade" id="renameModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <span class="material-icons-outlined">drive_file_rename_outline</span>
                    <span id="rename-title">Rename File</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label required-star" for="rename-input">New name</label>
                <input type="text" class="form-control form-control-sm" id="rename-input" maxlength="255" autocomplete="off" spellcheck="false" required>
                <div class="form-text">Cannot contain \ / &lt; &gt; : &quot; | ? * or end with a dot.</div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success btn-sm" id="confirm-rename-btn" disabled>Rename</button>
            </div>
        </div>
    </div>
</div>

<!-- New Folder Modal -->
<div class="modal fade" id="newFolderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <span class="material-icons-outlined text-success">create_new_folder</span>
                    New Folder
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label required-star" for="new-folder-input">Folder name</label>
                <input type="text" class="form-control form-control-sm" id="new-folder-input" maxlength="255" autocomplete="off" spellcheck="false" required>
                <div class="form-text">Created in <%= currentPath ? currentPath : 'the server root' %>.</div>
                <div class="form-text">Cannot contain \ / &lt; &gt; : &quot; | ? * or end with a dot.</div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success btn-sm" id="confirm-new-folder-btn" disabled>Create</button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/foot', { scripts: ['/js/serverState.js', '/js/files.js'] }) %>
