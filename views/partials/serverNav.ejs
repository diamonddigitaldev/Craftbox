<%
// stateColors / stateIcons / stateDisplayNames / getState* helpers come from
// res.locals (injected by serverStateMeta.injectIntoLocals middleware).
const _displayVersion = (server.serverType || 'vanilla') === 'custom'
    ? '(Unknown Version)'
    : (server.version || '(Unknown Version)');
// While the server directory is still being assembled, every page except
// Console and Events is closed (blockWhileProvisioning redirects them). Show
// that in the nav rather than letting the click bounce.
const _provisioning = server.state === 'provisioning';
const _gated = _provisioning ? ' disabled' : '';
const _gatedTitle = _provisioning ? ' title="Available once provisioning finishes" aria-disabled="true"' : '';
// Back goes to the page the server was reached from: its group page when it
// belongs to a group, the dashboard otherwise. A group is implicit — it exists
// only while a server is in it — so a group with this server in it is always
// a page that exists.
const _backHref = server.group
    ? `/dashboard/groups/${encodeURIComponent(server.group)}`
    : '/dashboard';
%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="server-nav-header" data-state="<%= server.state %>">
    <a href="<%= _backHref %>" class="btn btn-outline-secondary btn-sm d-flex align-items-center">
        <span class="material-icons-outlined" style="font-size: 1.2rem;">arrow_back</span>
    </a>
    <h4 class="mb-0"><%= server.name %></h4>
    <span class="badge bg-<%= getStateColor(server.state) %> d-flex align-items-center gap-1 server-state-badge" id="server-state-badge">
        <span class="material-icons-outlined" style="font-size: 0.9rem;" id="state-icon"><%= getStateIcon(server.state) %></span>
        <span id="state-text"><%= getStateDisplayName(server.state) %></span>
    </span>
    <span class="text-body-secondary ms-2 d-flex align-items-center gap-1" style="font-size: 0.85rem;">
        <img src="/img/server-types/<%= server.serverType || 'vanilla' %>.svg" alt="" class="server-type-logo">
        <%= (server.serverType || 'vanilla').charAt(0).toUpperCase() + (server.serverType || 'vanilla').slice(1) %> <span id="server-version-label"><%= _displayVersion %></span> &middot; Port <%= server.port %> &middot; <%= server.memory %> MB
    </span>
</div>
<ul class="nav nav-pills mb-3" id="server-nav">
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1<%= active === 'console' ? ' active' : '' %>" href="/servers/<%= server.id %>">
            <span class="material-icons-outlined" style="font-size: 1rem;">terminal</span> Console
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1<%= active === 'settings' ? ' active' : '' %><%= _gated %>" href="/servers/<%= server.id %>/edit"<%- _gatedTitle %>>
            <span class="material-icons-outlined" style="font-size: 1rem;">edit</span> Settings
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1<%= active === 'properties' ? ' active' : '' %><%= _gated %>" href="/servers/<%= server.id %>/properties"<%- _gatedTitle %>>
            <span class="material-icons-outlined" style="font-size: 1rem;">tune</span> Properties
        </a>
    </li>
    <%
    const _contentTypes = { paper: 'Plugins', purpur: 'Plugins', folia: 'Plugins', fabric: 'Mods', forge: 'Mods', neoforge: 'Mods' };
    const _contentLabel = _contentTypes[server.serverType] || null;
    const _contentIcon = 'extension';
    %>
    <% if (_contentLabel) { %>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1<%= active === 'plugins' ? ' active' : '' %><%= _gated %>" href="/servers/<%= server.id %>/plugins"<%- _gatedTitle %>>
            <span class="material-icons-outlined" style="font-size: 1rem;"><%= _contentIcon %></span> <%= _contentLabel %>
        </a>
    </li>
    <% } %>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1<%= active === 'files' ? ' active' : '' %><%= _gated %>" href="/servers/<%= server.id %>/files"<%- _gatedTitle %>>
            <span class="material-icons-outlined" style="font-size: 1rem;">folder</span> Files
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1<%= active === 'backups' ? ' active' : '' %><%= _gated %>" href="/servers/<%= server.id %>/backups"<%- _gatedTitle %>>
            <span class="material-icons-outlined" style="font-size: 1rem;">backup</span> Backups
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1<%= active === 'events' ? ' active' : '' %>" href="/servers/<%= server.id %>/events">
            <span class="material-icons-outlined" style="font-size: 1rem;">history</span> Events
        </a>
    </li>
</ul>
